  },
  "homepage": "https://www.mcpstamp.com/free-servers/",
  "bin": {
    "fdic-bank-health-failures-mcp": "dist/stdio.js"
  },
  "main": "dist/stdio.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
